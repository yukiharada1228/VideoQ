{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TfStateBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::videoq-terraform-state-<ACCOUNT_ID>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "videoq/prod/terraform.tfstate",
            "videoq/prod/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "TfStateRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::videoq-terraform-state-<ACCOUNT_ID>/videoq/prod/terraform.tfstate"
    },
    {
      "Sid": "TfStateLock",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::videoq-terraform-state-<ACCOUNT_ID>/videoq/prod/terraform.tfstate.tflock"
    },
    {
      "Sid": "CallerIdentity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
